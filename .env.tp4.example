# GLM-5.3-Flash EXL3 — EXPERIMENTAL 4× DGX Spark (TP=4)
# Copy to .env.tp4 and edit. ./start-tp4.sh does this on first run.
#
# Sourced AFTER .env, so these values win over the 2× TP=2 knobs
# (TP=2, NNODES=2, DFLASH_DRAFT_TP=2, NCCL_CROSS_NIC=0). start.sh never
# reads this file.

# --- ranks (edit these) ------------------------------------------------
# TCP bootstrap/SSH uses the management network. NCCL data traffic uses the
# ring fabric IF/HCA values below; never put a fabric /30 here.
HEAD_IP=192.168.2.180
WORKER_IP=192.168.2.161
WORKER2_IP=192.168.2.102
WORKER3_IP=192.168.2.238
# Mixed OS accounts (unset = same user as the head / WORKER_USER):
# WORKER_USER=
# WORKER2_USER=
# WORKER3_USER=
# WORKER2_HOME=/home/you
# WORKER3_HOME=/home/you
# WORKER2_SSH=you@10.0.0.3
# WORKER3_SSH=you@10.0.0.4

# --- fabric --------------------------------------------------------------
# Four Sparks need a RoCE path among all ranks (QSFP ring on both CX7
# ports, or a switch). NCCL cannot use the 10.0.0.x loopback aliases.
# Per-rank pins are what the containers get.
# Dual-port ring example (comma-separated HCAs / IFs):
#   HEAD_CX7_IB=rocep1s0f0,rocep1s0f1
#   HEAD_CX7_IF=enp1s0f0np0,enp1s0f1np1
NCCL_CROSS_NIC=1
HEAD_SOCKET_IFACE=wlP9s9
WORKER_SOCKET_IFACE=wlP9s9
WORKER2_SOCKET_IFACE=wlP9s9
WORKER3_SOCKET_IFACE=wlP9s9
# The values below are generated from ring_4port/topology.tsv by deploy.sh.
# Each rank gets both physical ports and all four RDMA devices.
HEAD_CX7_IF=enp1s0f0np0,enp1s0f1np1
HEAD_CX7_IB=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
WORKER_CX7_IF=enp1s0f0np0,enp1s0f1np1
WORKER_CX7_IB=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
WORKER2_CX7_IF=enp1s0f0np0,enp1s0f1np1
WORKER2_CX7_IB=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
WORKER3_CX7_IF=enp1s0f0np0,enp1s0f1np1
WORKER3_CX7_IB=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
# Per-rank RoCEv2 GID (empty = NCCL_IB_GID_INDEX). Inspect:
#   cat /sys/class/infiniband/<dev>/ports/1/gids/{0..7}
# HEAD_GID=3
# WORKER_GID=3
# WORKER2_GID=3
# WORKER3_GID=3
NCCL_IB_GID_INDEX=3
NCCL_ALGO=RING
NCCL_DEBUG=WARN

# --- serve (TP=4) --------------------------------------------------------
TP=4
NNODES=4
# Shard the DFlash2 drafter across all four ranks. 1 = rank 0 only.
DFLASH_DRAFT_TP=4
PORT=8888
MASTER_PORT=29521
CONTAINER_HEAD=glm53-exl3-tp4-head
CONTAINER_WORKER=glm53-exl3-tp4-w1
CONTAINER_WORKER2=glm53-exl3-tp4-w2
CONTAINER_WORKER3=glm53-exl3-tp4-w3

# Direct, read-only host model contract. All four hosts are prepared before
# start, so the launcher never downloads or rsyncs the 164G target at startup.
MODEL_ROOT=/opt/models
MODEL_PATH=/opt/models/Mia-AiLab/GLM-5.3-Flash-exl3-4bpw-ablit
WORKER_MODEL_ROOT=/opt/models
WORKER2_MODEL_ROOT=/opt/models
WORKER3_MODEL_ROOT=/opt/models
WORKER_MODEL_PATH=/opt/models/Mia-AiLab/GLM-5.3-Flash-exl3-4bpw-ablit
WORKER2_MODEL_PATH=/opt/models/Mia-AiLab/GLM-5.3-Flash-exl3-4bpw-ablit
WORKER3_MODEL_PATH=/opt/models/Mia-AiLab/GLM-5.3-Flash-exl3-4bpw-ablit
DFLASH_MODEL_PATH=/opt/models/incoai/GLM-5.3-Flash-DFlash2
SKIP_DOWNLOAD=1
SKIP_PULL=1
SKIP_BUILD=1
SKIP_SYNC=1
